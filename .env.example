# Security Gateway — env template. Copy to /etc/security-gateway/.env
# NEVER commit real values.

SG_HOST=127.0.0.1
SG_PORT=8850
SG_VERSION=0.1.0
SG_HMAC_KEY_PATH=/etc/security-gateway/hmac.key
SG_MODEL_CACHE_DIR=/var/lib/security-gateway/models
SG_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
SG_SEAL_TTL_HOURS=24
SG_LOG_PATH=/var/log/security-gateway/gateway.log
SG_CLAMDSCAN_BIN=clamdscan
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx   # only if PromptGuard is gated
